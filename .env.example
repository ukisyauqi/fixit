PORT=3000
# Root sandbox workspace tool Pi — WAJIB direktori khusus, JANGAN root / atau home.
# Tiap session kerja di foldernya sendiri: <AGENT_CWD>/<sessionId>/
AGENT_CWD=./workspace
# PI_MODEL opsional (default: dari ~/.pi/agent/settings.json).
# Format: "provider/model-id" atau bare id (provider diambil dari PI_PROVIDER).
# PI_MODEL=opencode-go/muse-spark-1.3-contributor
# PI_PROVIDER=opencode-go
# PI_REASONING_LEVEL=high
PROMPT_TIMEOUT_MS=120000
MAX_PROMPT_CHARS=8000
SESSION_TTL_MS=1800000
CORS_ORIGIN=http://localhost:5173
# Kosong = tanpa auth (dev lokal). Wajib diisi jika di-expose ke publik.
API_TOKEN=
# Tool yang dimatikan untuk endpoint publik (koma-separated). Kosongkan = semua aktif.
EXCLUDE_TOOLS=bash
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000
# Hapus folder workspace/<id>/ saat session idle di-evict. Default true (cegah disk leak).
CLEANUP_WORKSPACE_ON_EVICT=true
